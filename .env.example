# ─── AstroStack UI — build-time environment variables ───────────────────────
# Copy this file to .env and fill in the values for local development.
# These variables are embedded into the JavaScript bundle at build time.
# They set the DEFAULT values shown in the Settings page on first load.
# Users can reconfigure every endpoint at runtime from the Settings UI.

# Root URL of the AstroStack REST API, including the version prefix.
# Must match the address (and reverse-proxy path, if any) of your astro-api service.
VITE_API_BASE_URL=http://localhost:8080/api/v1

# WebSocket endpoint for real-time pipeline progress updates.
VITE_WS_BASE_URL=ws://localhost:8080/ws

# ─── Supabase (optional) ─────────────────────────────────────────────────────
# Only required if you use Supabase for optional UI-level persistence features.
# Leave empty to disable Supabase integration.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
